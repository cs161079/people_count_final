# Διευθυνση Application Server
# SERVER_URL=https://uat.osses.gr
SERVER_URL=http://uat.osses.gr
# Κωδικός οχήμάτος με το οποιό θα γίνετια η αποστολή και αποθήκευση των δεδομένων
bus.id=1998
#Χωριτικό του λεοφωρείου
bus.capacity=111
# Εάν θα κάνει αναπαράσταση ή κανονική εκτέλεση
# s = simulation mode
# c = cv with cameras mode
# v = cv with video files mode
mode=v
# Εάν θα τρέξει μία φορά ή θα εκτέλεση αναπαράσταση 
# για όλα τα δρομολόγια της γραμμής
run_ones=True
# Κάθε πότε να γίνεται αποστολή των δεδομέων στο Applicaition Server
# Προεπιλογή είναι τα 10 δευτερόλεπτα
deamon.delay=15
